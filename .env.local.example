# Copy to .env.local. Never commit .env.local — it is gitignored.
#
# These keys are read only by Next.js server-side API routes
# (src/app/api/**). The Chrome extension and the browser client
# never see them: not via localStorage, query params, trace JSON,
# or client props.

ANTHROPIC_API_KEY=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
BROWSERBASE_API_KEY=
