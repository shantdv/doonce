# Server-only secrets for local development.
# Copy this file to .env.local and fill in real values. Do not commit .env.local.
#
# These values must only be read by Next.js API routes or server-side libraries.
# Never expose them to the Chrome extension, browser localStorage, client props,
# trace JSON, query strings, or screenshots.

# Required for LLM TracePack compilation. Without this, the compiler falls back
# to the deterministic heuristic compiler and returns compiler.source=heuristic.
ANTHROPIC_API_KEY=

# Optional until hosted delivery and billing are enabled.
RESEND_API_KEY=
STRIPE_SECRET_KEY=
BROWSERBASE_API_KEY=
